<?xml version="1.0"?>
<!-- Overlay used only when OCTAVE_ENABLE_DOWNLOADS=OFF (app-store builds); see
     android/build.gradle. All-Files-Access exists for writing downloads into
     user-picked folders, and Play only grants it to file-manager-class apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
</manifest>
