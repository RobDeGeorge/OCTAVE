{
  "id": "performance",
  "label": "Performance",
  "schema": 2,
  "gridColumns": 12,
  "gridRows": 8,
  "cells": [
    {
      "type": "ArcGauge",
      "paramId": "SPEED",
      "col": 0, "row": 0, "colSpan": 12, "rowSpan": 4,
      "props": { "showNeedle": true, "majorTickCount": 9, "minorTicksPerMajor": 4 }
    },

    {
      "type": "DigitalReadout",
      "paramId": "RPM",
      "col": 0, "row": 4, "colSpan": 3, "rowSpan": 2,
      "props": { "valueScale": 3.2, "padDigits": 4 }
    },

    {
      "type": "WarningLight",
      "paramId": "COOLANT_TEMP",
      "col": 3, "row": 4, "colSpan": 2, "rowSpan": 2,
      "props": { "label": "TEMP", "triggerAbove": 105, "pulse": true, "maxSize": 90 }
    },

    {
      "type": "WarningLight",
      "paramId": "RPM",
      "col": 5, "row": 4, "colSpan": 2, "rowSpan": 2,
      "props": { "label": "REV",  "triggerAbove": 7000, "pulse": true, "maxSize": 90 }
    },

    {
      "type": "WarningLight",
      "paramId": "FUEL_LEVEL",
      "col": 7, "row": 4, "colSpan": 2, "rowSpan": 2,
      "props": { "label": "FUEL", "triggerBelow": 12, "activeColor": "#F1C40F", "maxSize": 90 }
    },

    {
      "type": "DigitalReadout",
      "paramId": "COOLANT_TEMP",
      "col": 9, "row": 4, "colSpan": 3, "rowSpan": 2,
      "props": { "valueScale": 3.2 }
    },

    {
      "type": "SparklineGauge",
      "paramId": "ENGINE_LOAD",
      "col": 0, "row": 6, "colSpan": 6, "rowSpan": 2,
      "props": { "fillBelow": true }
    },

    {
      "type": "SparklineGauge",
      "paramId": "TIMING_ADVANCE",
      "col": 6, "row": 6, "colSpan": 6, "rowSpan": 2,
      "props": { "fillBelow": true, "autoScale": true }
    }
  ],
  "layouts": {
    "portrait": {
      "gridColumns": 8,
      "gridRows": 12,
      "cells": [
        { "col": 0, "row": 0, "colSpan": 8, "rowSpan": 2 },
        { "col": 0, "row": 2, "colSpan": 4, "rowSpan": 2 },
        { "col": 4, "row": 2, "colSpan": 2, "rowSpan": 2 },
        { "col": 6, "row": 2, "colSpan": 2, "rowSpan": 2 },
        { "col": 0, "row": 4, "colSpan": 2, "rowSpan": 2 },
        { "col": 2, "row": 4, "colSpan": 4, "rowSpan": 2 },
        { "col": 0, "row": 6, "colSpan": 8, "rowSpan": 2 },
        { "col": 0, "row": 8, "colSpan": 8, "rowSpan": 2 }
      ]
    }
  }
}
