	)
	(text "Pod bus: battery voltage and RS-485 in and out, input protection, 3.3 V LDO"
		(exclude_from_sim no)
		(at 20 40 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "fc17cb6a-4a15-5938-9233-7d716eee0510")
	)
	(text "J1 and J7 (JST GH) are the same four nets, pin for pin: 1 VIN, 2 RS-485 A, 3 RS-485 B, 4 GND. Either is in or out."
		(exclude_from_sim no)
		(at 20 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ca50a52-7598-5603-b013-f3888d1f2047")
	)
	(text "VIN is the battery (OBD pin 16), switched and fused by the adapter, or a 5 V bench supply. This pod's own load"
		(exclude_from_sim no)
		(at 20 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f3a43aa9-e370-5e40-af51-2b6a9a98c40b")
	)
	(text "goes through F1 (0.5 A); the chain's current passes J1 to J7 on the board, ahead of F1."
		(exclude_from_sim no)
		(at 20 53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "75f51a1e-6f3c-599c-b686-fc93c8985105")
	)
	(text "D1 clamps a surge at 38.9 V and trips F1 on a reversed lead, D2 blocks reverse current. U1 takes 40 V, 2.7 uA."
		(exclude_from_sim no)
		(at 20 56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3bd78c8d-447d-5c61-932d-83e4d78655db")
	)
	(text "VBAT_SENSE = VIN_F x 0.180 (1M / 220k, 10 uA at 12.6 V): the battery, and the alternator charging (engine on)."
		(exclude_from_sim no)
		(at 20 59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "585bceb6-935c-53c8-ab70-06d353876839")
	)
	(text "U7 THVD2450: +-70 V on A / B (a cable pinched against VIN), IEC ESD and idle-bus failsafe inside, so no TVS"
		(exclude_from_sim no)
		(at 20 62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5c7f734b-af2d-5814-9101-80442149973e")
	)
	(text "and no bias resistors on the bus. RS485_DE (100k down) and RS485_RE (100k up, active low) are separate:"
		(exclude_from_sim no)
		(at 20 65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "72efca3b-c9cf-5a4f-b443-7b8c3cbddf0e")
	)
	(text "both idle = shutdown, under 1 uA; listening costs 1.8 mA. POD_RX has a 100k pull-up for when RO floats."
		(exclude_from_sim no)
		(at 20 68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f6080a4b-5df4-5596-af05-597d60a627eb")
	)
	(text "SW3 puts the 120R terminator across A / B (both poles ON): on the last pod of the chain only."
		(exclude_from_sim no)
		(at 20 71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ba9ba7bb-c799-5f4d-a240-10ed0fa2361e")
	)
