	)
	(text "J1 (JST GH): 1 VIN, 2 TX (pod to adapter), 3 RX (adapter to pod), 4 GND. 3.3 V logic. Standalone: 1 and 4 only."
		(exclude_from_sim no)
		(at 20 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b7544968-c731-5aee-8c8a-f2b6f5107957")
	)
	(text "VIN is the adapter's 5 V or the battery (OBD pin 16): F1 0.5 A, D1 clamps load dump at 38.9 V and trips F1"
		(exclude_from_sim no)
		(at 20 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "936e525e-fa5c-5db7-a656-752eab9e6d0f")
	)
	(text "on a reversed lead, D2 blocks reverse current. U1 takes 40 V and draws 2.7 uA."
		(exclude_from_sim no)
		(at 20 53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ec866e41-3e6c-5bee-9c2d-edcb37dc3100")
	)
	(text "VBAT_SENSE = VIN_F x 0.180 (1M / 220k, 10 uA at 12.6 V): the battery, and the alternator charging (engine on)."
		(exclude_from_sim no)
		(at 20 56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5d106d4b-bf8f-5608-9e3c-fbe5e93e48b3")
	)
	(text "POD_RX has a 100k pull-up: with no adapter the line idles high and the UART sees nothing."
		(exclude_from_sim no)
		(at 20 59 0)
		(effects
