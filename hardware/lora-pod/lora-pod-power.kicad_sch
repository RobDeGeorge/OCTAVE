				)
			)
		)
		(pin "1"
			(uuid "dd0f2c14-05a5-51d7-9b15-c8e56e269145")
		)
		(instances
			(project "lora-pod"
				(path "/c8085f09-0d89-59ec-b963-f77ec23732fa/b5e17ecd-f658-5e29-8c3f-cd5907c539f7"
					(reference "#PWR003")
					(unit 1)
