	(text "USB-C in, 2.40 V / 150 mA charger, the cell"
		(exclude_from_sim no)
		(at 20 45 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e393c739-77de-5ecd-97da-92c244f6aca4")
	)
	(text "Cell: Nichicon SLB12400H131 lithium titanate, 2.1 V nominal, 2.5 V maximum charge, 1.5 V discharge end, -30..80 C."
		(exclude_from_sim no)
		(at 20 52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "40e3fabf-67b7-56d9-b41b-56ca75ac6c6e")
	)
	(text "Charge voltage 0.8 V x (1 + 200k / 100k) = 2.40 V (2.34..2.46 V with 1 % parts): under the cell's 2.5 V at every tolerance."
		(exclude_from_sim no)
		(at 20 55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b26957ba-7daa-5d36-87ba-8eddcf59b934")
	)
	(text "The feedback divider returns through /PG, which is open with no USB: the divider draws nothing from the cell."
		(exclude_from_sim no)
		(at 20 58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "968498ee-5324-5f57-9632-4ae85b5776f6")
	)
	(text "Charge current 300 / R_ISET: 2.0k = 150 mA (about an hour). The charger is linear: 0.45 W into a 2 V cell, more into a flat one."
		(exclude_from_sim no)
		(at 20 61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "68467c1c-67be-5852-9e7d-85baa4d23089")
	)
	(text "CHG_CE high stops charging (firmware: cell full, or too hot). GPIO7 floats at reset and the pin pulls itself low: charging on."
		(exclude_from_sim no)
		(at 20 64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "41fb270e-82a6-55e1-9b8a-7721a4a9ee21")
	)
	(text "BQ25173 never terminates by itself: it holds 2.40 V while USB is in. STAT is open drain, low above 98 % of 2.40 V."
		(exclude_from_sim no)
		(at 20 67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "07e80f7d-1166-5b4e-be4a-53d6c8861da0")
	)
	(text "The USB ESD array's rail pin has its own 100n, not VBUS: on VBUS the D+ pull-up would lift VBUS_SENSE with no cable in."
		(exclude_from_sim no)
		(at 20 70 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3da7af92-a21d-504d-b0ac-0a4519343fc7")
	)
	(text "VBUS_SENSE = 0.6 x VBUS: 2.64 V at 4.4 V (a logic high), 3.3 V at 5.5 V."
		(exclude_from_sim no)
		(at 20 73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c4ccc4cd-1292-5fa8-995e-5d577be66a7c")
	)
	(text "F1 is in series with the cell (it can give tens of amps into a short). Lift it to put a meter in series."
		(exclude_from_sim no)
		(at 20 76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d58b757c-17ef-5dbe-807b-2ca764bc6b9c")
	)
