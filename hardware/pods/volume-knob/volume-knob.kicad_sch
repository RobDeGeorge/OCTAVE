	(text "ESP32-C3-MINI-1-H4X"
		(exclude_from_sim no)
		(at 561.904 45 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "51dbf32e-eee3-5292-b9ee-1f31975478d4")
	)
	(text "Deep-sleep wake is GPIO0..5 only: ENC_A (0), ENC_SW (3) and VBUS_SENSE (5) wake it; ENC_B (1) is read on wake."
		(exclude_from_sim no)
		(at 561.904 52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f2806c13-08e6-5413-9fa2-947e5806feee")
	)
	(text "Strapping pins GPIO2, 8, 9: pulled up, nothing on them that can be low at reset. BOOT (GPIO9) low at reset = download mode."
		(exclude_from_sim no)
		(at 561.904 55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8d8828c6-9e48-586d-8392-a045be2e032c")
	)
	(text "Flashing is over USB (GPIO18 D-, GPIO19 D+), no buttons. Recovery: short the BOOT pad to GND and tap EN to GND."
		(exclude_from_sim no)
		(at 561.904 58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "468f12cf-df97-5732-a1cb-bf0e45881f9d")
	)
	(text "Reset states: GPIO7 and GPIO10 float (charger on, LED rail off), GPIO6 and GPIO20 have a weak pull-up, GPIO21 prints the boot log."
		(exclude_from_sim no)
		(at 561.904 61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4054b8c3-fd94-5dbe-9fe6-e5e02f9043ff")
	)
	(text "VBAT_SENSE on GPIO4 = ADC1_CH4, 12 dB attenuation (0..2.5 V)."
		(exclude_from_sim no)
		(at 561.904 64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "50f7fb8e-c439-594b-a12b-26bcfa73a5fb")
	)
	(text "EN: a TPS3840DL28 holds the module in reset below 2.8 V on 3V3 (the rail rises and falls slowly with the cell)."
		(exclude_from_sim no)
		(at 561.904 67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cc69e5ea-5ea9-5fb5-a2e6-1a0733ffbe8a")
	)
	(text "CHG_STAT is on U0RXD: check once that the ROM downloader does not mind it low while a full cell is on USB."
		(exclude_from_sim no)
		(at 561.904 70 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
