	(text "Alps EC11J encoder with push switch"
		(exclude_from_sim no)
		(at 20 244.0065 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6756bf13-00ab-552e-89e6-0469d7314af8")
	)
	(text "30 detents, 15 pulses: A rests closed at every second detent, B's edges fall on the detents (Alps: B is not defined at rest)."
		(exclude_from_sim no)
		(at 20 251.0065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4ffc8f56-a72e-5961-a13d-cb0f0de03646")
	)
	(text "A, B and the switch all wake the knob (GPIO0, 1, 3). Firmware keeps the last A and B in RTC memory and decodes the quadrature in the wake stub:"
		(exclude_from_sim no)
		(at 20 254.0065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "77587164-721c-53a1-82a7-75a6ca331e6c")
	)
	(text "whichever of A and B moved first gives the direction. Waking on A alone and reading B afterwards is a race with the detent (B switches there)."
		(exclude_from_sim no)
		(at 20 257.0065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "95ff798e-8236-5174-914e-050d2c4cb4bf")
	)
	(text "1M pull-ups: a closed contact costs 3.3 uA asleep. Awake, firmware adds the internal 45k pull-ups to wet the contacts."
		(exclude_from_sim no)
		(at 20 260.0065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c4f4f086-d932-5a82-9783-06f7a9199066")
	)
	(text "220 pF on A and B: with the 1M an opening contact reaches a logic high in 0.3 ms (2.2 nF took 3 ms, as long as the wake itself). Debounce in firmware."
		(exclude_from_sim no)
		(at 20 263.0065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3483dbbf-29af-51c9-934b-845307aba13f")
	)
	(text "Switch pull-up 33k: 100 uA through the closed switch, Alps' minimum for it. It is open at rest."
		(exclude_from_sim no)
		(at 20 266.0065 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e7bafbb6-84d0-5409-83f5-416d65db566a")
	)
