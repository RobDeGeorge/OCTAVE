		(uuid "d56281e0-d9dd-5f57-b6a5-38ab879018e6")
	)
	(text "RX: LM2901B on CMP_VCC (DLC_SW via 1k, 33 V zener; 38 V abs max). VPW: Bus+ vs 5V_BUCK x 47/65 = 3.85 V, active high."
		(exclude_from_sim no)
		(at 157.48 57.26 0)
		(effects
