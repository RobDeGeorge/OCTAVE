	)
	(text "Bus+: 2N7002 -> AO3401A -> Schottky; 10k + Schottky bus load. Bus-: MMBT3904 sink, 10k + Schottky pull-up to 5 V."
		(exclude_from_sim no)
		(at 157.48 54.26 0)
