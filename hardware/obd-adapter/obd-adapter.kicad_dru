(version 1)
(rule "battery-side clearance"
  (condition "(A.NetName == '/BUCK_BOOT' || A.NetName == '/BUCK_SW' || A.NetName == '/CAN1_H' || A.NetName == '/CAN1_L' || A.NetName == '/CAN1_TERM' || A.NetName == '/CAN2_H' || A.NetName == '/CAN2_L' || A.NetName == '/CAN2_TERM' || A.NetName == '/CMP_VCC' || A.NetName == '/DLC_SW' || A.NetName == '/DLC_SW_G' || A.NetName == '/IDEAL_GATE' || A.NetName == '/IDEAL_VCAP' || A.NetName == '/J1850_N' || A.NetName == '/J1850_P' || A.NetName == '/J1850_PD' || A.NetName == '/KLINE' || A.NetName == '/KLINE_PU' || A.NetName == '/K_IN' || A.NetName == '/LLINE' || A.NetName == '/LLINE_PU' || A.NetName == '/VBAT_F' || A.NetName == '/VBAT_IN' || A.NetName == '/VBAT_P' || A.NetName == '/VJ1850') && A.NetName != B.NetName")
  (constraint clearance (min 0.30mm)))
