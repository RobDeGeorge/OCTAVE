				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "047530e0-4ed9-54e8-be38-0ca3991f3597")
	)
	(text "latch side) goes on the main board's top. Pins 4 (chassis) and 5 (signal) ground both go to GND."
		(exclude_from_sim no)
		(at 20.32 28.86 0)
