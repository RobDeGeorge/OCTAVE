	(text "ESP32-WROOM-32E: Bluetooth Classic SPP + BLE (FFE0/FFE1) + Wi-Fi bridge"
		(exclude_from_sim no)
		(at 20 234.8145 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "02b25908-ff2d-52b3-9b56-e3d9bad32b2e")
	)
	(text "STM32 link: ESP32 UART2 on IO16 (RX) / IO17 (TX), CTS IO18 (from PA1 RTS), RTS IO19 (to PA0 CTS), up to 3 Mbaud."
		(exclude_from_sim no)
		(at 20 241.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aa18461a-8813-53e1-91cd-296a774a5801")
	)
	(text "UART0 + EN + IO0 also on J_ESP for esptool; the STM32 can reset (PB7) and strap IO0 (PB5) itself."
		(exclude_from_sim no)
		(at 20 244.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ec2d6830-7fb3-5609-afc5-114396558b2d")
	)
	(text "Power-gated by a TPS22918 on PB6 (off at reset), placed at the module's 3V3 pin with its caps."
		(exclude_from_sim no)
		(at 20 247.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "871367a0-80c2-5b8b-9efe-08953c243fb5")
	)
	(text "Fit a shunt on JP_ESP_ON to power the ESP32 without STM32 firmware (blank-board esptool flashing)."
		(exclude_from_sim no)
		(at 20 250.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d63dda2b-ac94-5135-b066-3e24ea2fd4ec")
	)
	(text "1k in series with PA1/PA2/PB5/PB7 limits back-powering through the ESP32's I/O while it is off;"
		(exclude_from_sim no)
		(at 20 253.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c9763292-3a12-53bb-9292-379779f8328b")
	)
	(text "firmware still keeps them low or input until ESP_PWR_EN is on, and drives EN open-drain."
