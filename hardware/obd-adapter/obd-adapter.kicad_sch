	(text "Power: J1962 pin 16 -> PTC -> TVS -> ideal diode -> 5.3 V buck; USB OR'd in; 3.3 V LDO"
		(exclude_from_sim no)
		(at 535.872 234.8145 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "549be2c8-b568-5bdf-af00-0456517329be")
	)
	(text "5.0SMDJ26CA (5 kW) is bidirectional on purpose: a unidirectional TVS would short a reversed battery through the PTC."
		(exclude_from_sim no)
		(at 535.872 241.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1b003dd2-38a4-5d98-8aaf-20f065748734")
	)
	(text "Everything on VBAT_P must survive the ~42 V TVS clamp: LM74700 65 V, AO4264E 60 V, TPS54360B 60 V, caps 50 V."
		(exclude_from_sim no)
		(at 535.872 244.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "adb587f8-3c21-58aa-b8ef-d2d3b579acf8")
	)
	(text "TPS54360B: datasheet 600 kHz design (Fig. 32) with FB 57.6k/10.2k = 5.32 V, so 5V is ~4.9 V after the SS34 OR."
		(exclude_from_sim no)
		(at 535.872 247.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "81935673-71ee-5f81-8f55-859b8f4c5ece")
	)
	(text "EN left open (internal pull-up): the internal UVLO (~4.3 V) keeps the buck running through a 6 V cold crank."
		(exclude_from_sim no)
		(at 535.872 250.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b1e41a64-8235-5641-a69c-a978ed8cc4f0")
	)
	(text "5V_BUCK (not the OR'd 5V) feeds everything on the vehicle side: CAN VCC, the VPW reference, the Bus- pull-up."
		(exclude_from_sim no)
		(at 535.872 253.8145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "62a6e473-9dac-50da-9990-e4ce854d1d98")
	)
