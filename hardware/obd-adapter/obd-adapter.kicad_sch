	(text "USB-C for the ESP32 (CH340C on UART0, auto-reset): esptool / console without the STM32"
		(exclude_from_sim no)
		(at 20 618.44 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7091e11e-0ece-5c6f-a035-cda1e7c223a1")
	)
	(text "Second USB-C (sink, 5.1k CC). VBUS2 powers the board through its own Schottky and turns the ESP32's"
		(exclude_from_sim no)
		(at 20 625.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "704a1a98-6829-5595-98b2-d0106cf6e1fc")
	)
	(text "load switch on through a diode, so esptool works on a board whose STM32 is blank."
		(exclude_from_sim no)
		(at 20 628.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ff33cab9-3e40-5d27-9474-eec54c56abb1")
	)
	(text "CH340C runs from 3V3_ESP: it is off whenever the ESP32 is, so it can't back-power the module through RXD0."
		(exclude_from_sim no)
		(at 20 631.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6b25959c-007e-5346-98a2-314b9ae9561b")
	)
	(text "Auto-reset: the usual two-NPN cross pair on DTR/RTS drives EN and IO0 (esptool's default reset)."
		(exclude_from_sim no)
		(at 20 634.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8ddeb0d5-6bd6-532f-9406-5067585668b0")
	)
	(text "1k in series with the CH340C TXD, so an adapter on J3 can still drive RXD0."
		(exclude_from_sim no)
		(at 20 637.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "add28113-2b2b-5810-be67-5ef856f46b11")
	)
