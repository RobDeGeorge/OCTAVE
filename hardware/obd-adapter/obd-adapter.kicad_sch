	(text "STM32G474RET6: vehicle-side real-time engine"
		(exclude_from_sim no)
		(at 20 40 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d77cdb57-00fe-56d1-85f5-11a9a3b94367")
	)
	(text "FDCAN1 is not used: its pins clash with USB (PA11/PA12) and BOOT0 (PB8)."
		(exclude_from_sim no)
		(at 20 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9fb21ed5-694c-501e-8ee8-2d854682f8c7")
	)
	(text "HS-CAN (J1962 6/14) = FDCAN2 PB12/PB13. MS-CAN (3/11) = FDCAN3 PB3/PB4."
		(exclude_from_sim no)
		(at 20 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "788e839b-79f5-5a1e-b99e-b8bfc4d85ce6")
	)
	(text "J1850 on TIM3: CH1 VPW RX, CH2 PWM RX (input capture), CH3/CH4 TX Bus+/Bus- (output compare)."
		(exclude_from_sim no)
		(at 20 53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9d4c6263-a0c2-5309-805f-25697f2419aa")
	)
	(text "K-line on LPUART1 (PC0 RX / PC1 TX, TXINV: the NPN inverts); 5-baud init bit-bangs PC1. ESP32 on USART2 + RTS/CTS."
		(exclude_from_sim no)
		(at 20 56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3054a3a3-f9bb-5edc-9485-66d39562bf13")
	)
	(text "PC3 switches DLC_SW (battery to the J1850 supply, comparators, K/L pull-ups); PB2 picks 7.7 V VPW / 5.8 V PWM."
		(exclude_from_sim no)
		(at 20 59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9b478b96-10d8-56e5-919a-2bc202a45931")
	)
	(text "PB4/PB6 carry UCPD dead-battery pull-downs until firmware sets PWR_CR3.UCPD_DBDIS: both are safe low at reset."
		(exclude_from_sim no)
		(at 20 62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3c065073-dacd-51cc-9574-550c3776c2ec")
	)
	(text "DLC_SW_EN is on PC3, not PC10: the system bootloader may drive USART3 TX (PC10) and would switch DLC_SW on."
		(exclude_from_sim no)
		(at 20 65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7ae3963f-1bef-53a7-aa1d-aca0e1f91c37")
	)
