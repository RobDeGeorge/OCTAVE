	(text "microSD on the ESP32 (SPI): backup store for the phone's traffic stop recordings"
		(exclude_from_sim no)
		(at 20 238.9775 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "099540a7-0ad7-59b3-9a83-55f4b3aa93fc")
	)
	(text "J10 microSD (push-pull) in SPI mode: MISO IO4, CLK IO5, MOSI IO21, CS IO22, card detect IO23"
		(exclude_from_sim no)
		(at 20 245.9775 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "730c4d73-cc3d-5f63-ad4e-25af1e9cbdad")
	)
	(text "(switch to GND, ESP32 internal pull-up). Powered from 3V3_ESP: off with the ESP32."
		(exclude_from_sim no)
		(at 20 248.9775 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2146249b-851c-5c52-81f3-198c2b7d29ef")
	)
	(text "10k pull-ups (RN1 array + R68) on CS / MOSI / MISO and the unused DAT1 / DAT2 (SD spec). The card slides in from the"
		(exclude_from_sim no)
		(at 20 251.9775 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4390be48-5e0a-5d84-9278-7bd2da26ddf6")
	)
	(text "bottom edge and sticks out about 3 mm, so it can be pulled."
		(exclude_from_sim no)
		(at 20 254.9775 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "891ee37e-86fe-5d42-91f6-5e5f265a2a9c")
	)
