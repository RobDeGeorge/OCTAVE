	(text "ESP32 serial port on the USB hub (CH340C on UART0, auto-reset), reset / boot buttons"
		(exclude_from_sim no)
		(at 263.65 25 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ccd8893c-0a6d-5c3b-b1b5-9a89b273ec0c")
	)
	(text "Rev 0 had a second USB-C (J7) for this; the compact board has one port and a hub (U18, USB block), so"
		(exclude_from_sim no)
		(at 263.65 32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "118027fa-d3b5-5441-9c5c-54bba4987e83")
	)
	(text "J7 and its ESD / CC / VBUS parts (R61, R62, U13, C44, D25) are gone and their references stay unused."
		(exclude_from_sim no)
		(at 263.65 35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b5f62b90-5b50-5ddc-a38f-650c8176b169")
	)
	(text "VBUS turns the ESP32's load switch on through a diode, so esptool works on a board whose STM32 is blank."
		(exclude_from_sim no)
		(at 263.65 38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6d532ba2-7f5b-56e9-b05b-a882cbc6a6c2")
	)
	(text "CH340C runs from 3V3_ESP: it is off whenever the ESP32 is, so it can't back-power the module through RXD0."
		(exclude_from_sim no)
		(at 263.65 41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8aedace6-bd6e-52e0-b3fa-d14d4f228c58")
	)
	(text "Auto-reset: the usual two-NPN cross pair on DTR/RTS drives EN and IO0 (esptool's default reset)."
		(exclude_from_sim no)
		(at 263.65 44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e5af0cf3-ed93-514e-8d49-e6c46c01c120")
	)
	(text "1k in series with the CH340C TXD: it limits the current into RXD0, and a probe on the net can still drive it."
		(exclude_from_sim no)
		(at 263.65 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da42d41c-41f3-59dc-91b8-acdee1e96044")
	)
	(text "SW4 / SW5 pull EN / IO0 low by hand."
		(exclude_from_sim no)
		(at 263.65 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f4ee1134-372c-5a4d-b4de-74ca7016298d")
	)
