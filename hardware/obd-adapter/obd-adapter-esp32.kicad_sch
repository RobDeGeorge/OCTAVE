	(text "ESP32: radio bridge, its USB serial port, microSD"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f4cb80d7-2851-5183-8e00-6631fb94d932")
	)
	(text "STM32 link: ESP32 UART2 on IO16 (RX) / IO17 (TX), CTS IO18 (from PA1 RTS), RTS IO19 (to PA0 CTS), up to 3 Mbaud."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ad33f919-724b-52de-a9b3-c07352a5c613")
	)
	(text "UART0 goes to the CH340C on the USB hub's port 2 (auto-reset); the STM32 can reset (PB7) and strap IO0 (PB5) itself."
		(exclude_from_sim no)
		(at 20.32 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3d6c155a-6255-57f6-b3b0-2e3cfab92e9c")
	)
	(text "Power-gated by a TPS22918 on PB6 (off at reset), placed at the module's 3V3 pin with its caps."
		(exclude_from_sim no)
		(at 20.32 28.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2fa3605a-9cb0-5a7f-971b-169b91151fbb")
	)
	(text "CONFIG switch 1 (ESP_ON) powers the ESP32 without STM32 firmware; plugging in the USB-C does too."
		(exclude_from_sim no)
		(at 20.32 31.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce45f06a-a55b-557a-a0dc-5e93d459debb")
	)
	(text "1k in series with PA1/PA2/PB5/PB7 limits back-powering through the ESP32's I/O while it is off;"
		(exclude_from_sim no)
		(at 20.32 34.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f684c5f1-efdf-5870-99d8-5d931ca018fa")
	)
	(text "firmware still keeps them low or input until ESP_PWR_EN is on, and drives EN open-drain."
		(exclude_from_sim no)
		(at 20.32 37.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e307245c-2322-5dbf-80a6-fae74e44182a")
	)
	(text "J8 (DNP): ESP32 IO14 27 26 25 33 32 35 34 + 3V3_ESP / GND; 3.3 V logic, IO34/35 input-only."
		(exclude_from_sim no)
		(at 20.32 40.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ceaccdc-f608-57b0-99c1-98cf5ed3c6ba")
	)
	(text "Rev 0 had a second USB-C (J7) for this; the compact board has one port and a hub (U18, USB block), so"
		(exclude_from_sim no)
		(at 215.9 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "23a3e9a2-0783-52a9-8a8e-ec4a43af1fd4")
	)
	(text "J7 and its ESD / CC / VBUS parts (R61, R62, U13, C44, D25) are gone and their references stay unused."
		(exclude_from_sim no)
		(at 215.9 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b1b2abcc-6a26-512d-9f4b-f940f6348243")
	)
	(text "VBUS turns the ESP32's load switch on through a diode, so esptool works on a board whose STM32 is blank."
		(exclude_from_sim no)
		(at 215.9 28.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0e30e54a-e864-55b1-8d73-3016c4f44e8c")
	)
	(text "CH340C runs from 3V3_ESP: it is off whenever the ESP32 is, so it can't back-power the module through RXD0."
		(exclude_from_sim no)
		(at 215.9 31.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "08c5887e-2ffb-530d-b7fa-84ceded12002")
	)
	(text "Auto-reset: the usual two-NPN cross pair on DTR/RTS drives EN and IO0 (esptool's default reset)."
		(exclude_from_sim no)
		(at 215.9 34.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c27a4159-a049-5afd-bbfc-cdea3a18d36c")
	)
