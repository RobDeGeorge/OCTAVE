	(text "ESP32-WROOM-32E: Bluetooth Classic SPP + BLE (FFE0/FFE1) + Wi-Fi bridge"
		(exclude_from_sim no)
		(at 20 40 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "367d3e58-27e7-5e87-ac16-9832e192786c")
	)
	(text "STM32 link: ESP32 UART2 on IO16 (RX) / IO17 (TX), CTS IO18 (from PA1 RTS), RTS IO19 (to PA0 CTS), up to 3 Mbaud."
		(exclude_from_sim no)
		(at 20 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "414fe59d-ac84-5581-9cc4-5b17d540af69")
	)
	(text "UART0 goes to its own USB-C (CH340C, auto-reset); the STM32 can reset (PB7) and strap IO0 (PB5) itself."
		(exclude_from_sim no)
		(at 20 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b4daf1c8-f941-5ffa-910b-d30dcc67d148")
	)
	(text "Power-gated by a TPS22918 on PB6 (off at reset), placed at the module's 3V3 pin with its caps."
		(exclude_from_sim no)
		(at 20 53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "09b66b83-250f-5b32-ab51-06f636839ce5")
	)
	(text "CONFIG switch 1 (ESP_ON) powers the ESP32 without STM32 firmware; plugging in its USB-C does too."
		(exclude_from_sim no)
		(at 20 56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a1a37528-4ade-5daa-bb95-18d7e152639d")
	)
	(text "1k in series with PA1/PA2/PB5/PB7 limits back-powering through the ESP32's I/O while it is off;"
		(exclude_from_sim no)
		(at 20 59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c14a7308-7564-5cbb-a486-14ccef40267b")
	)
	(text "firmware still keeps them low or input until ESP_PWR_EN is on, and drives EN open-drain."
		(exclude_from_sim no)
		(at 20 62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b6d05651-9f57-5dff-b9e4-c25563949266")
	)
	(text "J8 (DNP): ESP32 IO14 27 26 25 33 32 35 34 + 3V3_ESP / GND; 3.3 V logic, IO34/35 input-only."
