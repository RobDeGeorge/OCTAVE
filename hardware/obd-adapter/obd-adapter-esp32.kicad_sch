	(text "ESP32: ESP32 radio bridge, its own USB-C / CH340C, microSD"
		(exclude_from_sim no)
		(at 20 14 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "432766ae-7a21-59e6-859f-3620dcbef6f2")
	)
	(text "ESP32-WROOM-32E: Bluetooth Classic SPP + BLE (FFE0/FFE1) + Wi-Fi bridge"
		(exclude_from_sim no)
		(at 20 25 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a2c5a0c5-4ed2-552d-839d-5211c42ebaee")
	)
	(text "STM32 link: ESP32 UART2 on IO16 (RX) / IO17 (TX), CTS IO18 (from PA1 RTS), RTS IO19 (to PA0 CTS), up to 3 Mbaud."
		(exclude_from_sim no)
		(at 20 32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f00254a5-e6fd-580f-945d-c58c6cd98b68")
	)
	(text "UART0 goes to the CH340C on the USB hub's port 2 (auto-reset); the STM32 can reset (PB7) and strap IO0 (PB5) itself."
		(exclude_from_sim no)
		(at 20 35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d75134b2-10bc-592b-ab72-790cb2315bc4")
	)
	(text "Power-gated by a TPS22918 on PB6 (off at reset), placed at the module's 3V3 pin with its caps."
		(exclude_from_sim no)
		(at 20 38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "31e35895-0c6d-5aab-a2e3-8c94f43257f9")
	)
	(text "CONFIG switch 1 (ESP_ON) powers the ESP32 without STM32 firmware; plugging in the USB-C does too."
		(exclude_from_sim no)
		(at 20 41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3612e400-f9f5-567e-a5ac-434a3f5cd793")
	)
	(text "1k in series with PA1/PA2/PB5/PB7 limits back-powering through the ESP32's I/O while it is off;"
		(exclude_from_sim no)
		(at 20 44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "14147289-8536-5d70-a99f-b39139c47227")
	)
	(text "firmware still keeps them low or input until ESP_PWR_EN is on, and drives EN open-drain."
		(exclude_from_sim no)
		(at 20 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5009bbde-98f8-56d4-8132-1c8f064655df")
	)
