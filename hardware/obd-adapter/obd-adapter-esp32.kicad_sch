	(text "microSD on the ESP32 (SPI): backup store for the phone's traffic stop recordings"
		(exclude_from_sim no)
		(at 20 220.585 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "06135c5a-1a04-5ef8-9416-3c6d788ca5b5")
	)
	(text "J10 microSD (push-pull) in SPI mode: MISO IO4, CLK IO5, MOSI IO21, CS IO22, card detect IO23"
		(exclude_from_sim no)
		(at 20 227.585 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2c4ecc86-a34c-5db3-9ba9-fcf0ce37bbdd")
	)
	(text "(switch to GND, ESP32 internal pull-up). Powered from 3V3_ESP: off with the ESP32."
		(exclude_from_sim no)
		(at 20 230.585 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "193360d1-d559-5475-924b-53d79239e0ea")
	)
	(text "10k pull-ups (RN1 array + R68) on CS / MOSI / MISO and the unused DAT1 / DAT2 (SD spec). The card slides in from the"
		(exclude_from_sim no)
		(at 20 233.585 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fa6fa08a-ee4d-52ac-83b4-20d4bd34056c")
	)
	(text "bottom edge and sticks out about 3 mm, so it can be pulled."
		(exclude_from_sim no)
		(at 20 236.585 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6ff37e94-7c89-5cf8-b007-17c84affd913")
	)
