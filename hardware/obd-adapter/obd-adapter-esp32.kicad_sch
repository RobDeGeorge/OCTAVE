	(text "USB-C for the ESP32 (CH340C on UART0, auto-reset): esptool / console without the STM32"
		(exclude_from_sim no)
		(at 263.65 40 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7dcf3119-b182-5f33-930f-6bed921a0dfc")
	)
	(text "Second USB-C (sink, 5.1k CC). VBUS2 powers the board through its own Schottky and turns the ESP32's"
		(exclude_from_sim no)
		(at 263.65 47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "18c2df89-215c-52a4-a182-d41302d3a8a4")
	)
	(text "load switch on through a diode, so esptool works on a board whose STM32 is blank."
		(exclude_from_sim no)
		(at 263.65 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d6850632-356e-5c38-b9bf-dd12373c8375")
	)
	(text "CH340C runs from 3V3_ESP: it is off whenever the ESP32 is, so it can't back-power the module through RXD0."
		(exclude_from_sim no)
		(at 263.65 53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8e551db6-6834-5bbf-9211-ea88f08a48b3")
	)
	(text "Auto-reset: the usual two-NPN cross pair on DTR/RTS drives EN and IO0 (esptool's default reset)."
		(exclude_from_sim no)
		(at 263.65 56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1e6ad2ac-c588-56e9-ad0f-b07536113c86")
	)
	(text "1k in series with the CH340C TXD, so an adapter on J3 can still drive RXD0."
		(exclude_from_sim no)
		(at 263.65 59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "811ceba6-1a79-518e-94f4-ec4280ba36ad")
	)
