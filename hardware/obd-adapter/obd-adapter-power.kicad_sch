	(text "Power: J1962 pin 16 -> PTC -> TVS -> ideal diode -> 5.3 V buck -> 5 V OR (USB) -> 3.3 V LDO"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2c21cee2-64cd-5c52-89b6-ef543f1fe937")
	)
	(text "5.0SMDJ26CA (5 kW) is bidirectional on purpose: a unidirectional TVS would short a reversed battery through the PTC."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f7161ce3-3160-5ba7-bd48-e1fa7f0310c9")
	)
	(text "Everything on VBAT_P must survive the ~42 V TVS clamp: LM74700 65 V, AO4264E 60 V, TPS54360B 60 V, caps 50 V."
		(exclude_from_sim no)
		(at 20.32 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cff9e379-e38c-51a4-81f8-683d4bd5de15")
	)
	(text "TPS54360B: datasheet 600 kHz design (Fig. 32) with FB 57.6k/10.2k = 5.32 V, so 5V is ~4.9 V after the SS34 OR."
		(exclude_from_sim no)
		(at 20.32 28.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9e301dbc-e8a8-51cf-9d4c-791aeb89063f")
	)
	(text "EN left open (internal pull-up): the internal UVLO (~4.3 V) keeps the buck running through a 6 V cold crank."
		(exclude_from_sim no)
		(at 20.32 31.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc92a16f-c62e-59ce-bab2-e5727b0a371c")
	)
	(text "5V_BUCK (not the OR'd 5V) feeds everything on the vehicle side: CAN VCC, the VPW reference, the Bus- pull-up."
		(exclude_from_sim no)
		(at 20.32 34.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4a3a4122-69ce-53ef-aded-f78d77fb6099")
	)
	(text "5 V: the buck OR'd with USB power; 3.3 V LDO"
		(exclude_from_sim no)
		(at 132.08 147.32 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7de17ca2-3d74-550b-91e3-d69370130720")
	)
	(text "(from the STM32's USB-C)"
		(exclude_from_sim no)
		(at 153.67 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
