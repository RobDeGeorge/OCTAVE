	(text "Parked watch and evidence: accelerometer, secure element, panic button"
		(exclude_from_sim no)
		(at 20 150.8205 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "dbd56851-a8ed-5779-8724-a10e0ebc2e3c")
	)
	(text "U15 LIS2DH12 on the STM32 I2C bus (0x19, SA0 high): wake-on-motion while parked (tow / break-in),"
		(exclude_from_sim no)
		(at 20 157.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "383e35b1-ef13-52ed-9ad0-9b7409a1775a")
	)
	(text "crash spikes while driving. INT1 -> PC14, INT2 -> PC15 (EXTI, wake from Stop)."
		(exclude_from_sim no)
		(at 20 160.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8217a460-c4fa-52be-beaa-e546fedccbe7")
	)
	(text "U16 ATECC608B (0x60) on the same bus: signs the frozen OBD speed window for traffic stop evidence."
		(exclude_from_sim no)
		(at 20 163.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a54ee2fa-6549-507b-9bab-d00454466362")
	)
	(text "J9 panic button (hidden, on a cable): 1k series at the connector, then the ESD diode, 10k pull-up"
		(exclude_from_sim no)
		(at 20 166.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7133d334-e6a4-5bb7-a1e6-854931b42cae")
	)
	(text "and 100n at the pin, so a cable shorted to +12 V is limited to ~8 mA into the clamp."
		(exclude_from_sim no)
		(at 20 169.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cbdbe4ed-cf26-510a-8209-d2031e19c436")
	)
	(text "PANIC_BTN = PC13 (WKUP2, wakes from Standby too). Closed = low."
		(exclude_from_sim no)
		(at 20 172.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c041a95d-a001-59dc-b20b-18a69e160181")
	)
