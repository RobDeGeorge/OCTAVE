	(text "U19 TPS27S100A: a high-side switch that limits the current (R72 3k: 0.82 A, 0.59-1.05 A over tolerance and"
		(exclude_from_sim no)
		(at 190.5 130.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "85fd8aba-49c6-5c5c-9015-9621e2554843")
	)
	(text "temperature) and shuts down hot, then retries: a pod cable shorted to ground is survived, at 0.14-0.24 A"
		(exclude_from_sim no)
		(at 190.5 133.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
