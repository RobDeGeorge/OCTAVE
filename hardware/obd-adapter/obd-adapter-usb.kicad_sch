	)
	(text "U18 CH334P (USB 2.0 hub, 4 ports, 2 used): port 3 is the STM32 (PA11 / PA12), port 2 the CH340C on the"
		(exclude_from_sim no)
		(at 20.32 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d5abb7d0-f45d-5b86-b1d1-328b44d50ea3")
	)
	(text "ESP32's UART0. Both show up on the computer at once, with no firmware on either chip."
		(exclude_from_sim no)
		(at 20.32 28.86 0)
		(effects
