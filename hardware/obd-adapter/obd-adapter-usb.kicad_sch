		(uuid "cc5faf31-0f83-5dd7-b28d-403e5bfd1a36")
	)
	(text "POD_EN is PD2 (EXP_PD2 on J5) through 4.7k, off at reset (100k). Off, U19 draws under 2 uA. Its fault"
		(exclude_from_sim no)
		(at 190.5 142.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "367c7358-4a15-5bed-8228-d88b91860ece")
	)
	(text "flag is not connected, and the adapter cannot measure the rail. U19 is rated 40 V, 48 V for 0.4 s."
		(exclude_from_sim no)
		(at 190.5 145.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "160524e3-e8bb-5607-9069-6a2b9fc8dbef")
	)
	(text "U17 THVD2450: +-70 V on A / B (a cable pinched against POD_VIN), IEC ESD and idle-bus failsafe inside:"
		(exclude_from_sim no)
		(at 190.5 148.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "46fe23f3-ab6c-5a18-ab63-1d37f1acdf73")
	)
	(text "no TVS, no bias resistors. It shares USART1 with J5: DI is PC4 (EXP_TX), RO reaches PC5 (EXP_RX) through 1k,"
		(exclude_from_sim no)
		(at 190.5 151.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a29b04a4-2653-58f9-87be-0942670c1ada")
	)
	(text "so a USB-UART adapter on J5 still wins. DE is PA5 (100k down), RE (active low) is PC10 (100k up):"
		(exclude_from_sim no)
		(at 190.5 154.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d120fbe5-1b9b-53da-b5f1-9d741de42197")
	)
	(text "both idle = shutdown, under 1 uA, and RO floats (firmware: pull PC5 up). Listening costs 1.8 mA."
		(exclude_from_sim no)
		(at 190.5 157.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "75a4e048-c637-5ba4-95a2-1e44b3969920")
	)
	(text "PC10 is USART3 TX to the system bootloader, which may toggle RE: that only switches the receiver."
		(exclude_from_sim no)
		(at 190.5 160.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "18a51304-6a6f-5d6d-8d0c-cd10246275fb")
	)
	(text "R72 sets the current limit"
		(exclude_from_sim no)
		(at 190.5 217.17 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "45ab23a2-cb86-56ab-a4b5-f19770636dd7")
	)
	(text "R74 / R75: driver and receiver"
		(exclude_from_sim no)
		(at 303.53 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1213d01e-6f60-5cf6-9bee-9178d6357dc2")
	)
	(text "off until firmware drives them"
		(exclude_from_sim no)
		(at 303.53 236.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b6d04882-4a42-54c6-b365-508139903039")
	)
	(text "at U17"
		(exclude_from_sim no)
		(at 382.27 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2487b798-b167-527a-a610-a77e686b1612")
	)
