	(text "USB, expansion, parked watch, pod bus"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "87bca187-1955-5e37-8ba2-ee4aaf0e1b6e")
	)
	(text "5.1k on CC1/CC2 = sink. VBUS feeds the 5 V rail through a Schottky (bench power without a car)."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "88e53939-9138-5f44-bc43-6c128d85b354")
	)
	(text "U18 CH334P (USB 2.0 hub, 4 ports, 2 used): port 3 is the STM32 (PA11 / PA12), port 2 the CH340C on the"
		(exclude_from_sim no)
		(at 20.32 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d5abb7d0-f45d-5b86-b1d1-328b44d50ea3")
	)
	(text "ESP32's UART0. Both show up on the computer at once, with no firmware on either chip. (Port 3, not 1:"
		(exclude_from_sim no)
		(at 20.32 28.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "642394b7-d535-58d3-bbfe-3148ec413e07")
	)
	(text "ports 2 and 3 leave the chip on one side, and the upstream pair, laid by hand, has the next side alone.)"
		(exclude_from_sim no)
		(at 20.32 31.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c6bdc9fe-60ef-5782-8687-a916ec419ec5")
	)
	(text "The hub runs from 3V3 (V5 and VDD33 both on it, as its datasheet advises for a hub on the board), so it is"
		(exclude_from_sim no)
		(at 20.32 34.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6baf5c33-5927-53d5-b35b-4459bba7efde")
	)
	(text "powered whenever the STM32 and the CH340C are: their D+ pull-ups never drive an unpowered chip. With no"
		(exclude_from_sim no)
		(at 20.32 37.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9c82aae3-25d7-55d7-9432-a8d2da70666c")
	)
	(text "cable in it sleeps: 0.12 mA typical, 0.4 mA at most, added to what the board draws while parked."
		(exclude_from_sim no)
		(at 20.32 40.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8c248577-cf5d-5cd1-bdb1-15d83e0459cc")
	)
	(text "Y2 12 MHz: the chip has load capacitors inside. (Crystal-free is an order option of the CH334, not the default.)"
		(exclude_from_sim no)
		(at 20.32 43.86 0)
		(effects
