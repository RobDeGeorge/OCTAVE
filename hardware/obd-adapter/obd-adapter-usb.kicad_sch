	)
	(text "U17 THVD2450: +-70 V on A / B (a cable pinched against POD_VIN), IEC ESD and idle-bus failsafe inside:"
		(exclude_from_sim no)
		(at 190.5 148.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
