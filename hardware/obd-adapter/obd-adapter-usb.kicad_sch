		(uuid "e9dcf6cb-299e-58b3-b279-7ac4b84524c7")
	)
	(text "U2's clamp rail (pin 5) is on 3V3, not VBUS, as the hub's datasheet asks: on VBUS the hub's D+ pull-up would feed"
		(exclude_from_sim no)
		(at 20.32 31.86 0)
