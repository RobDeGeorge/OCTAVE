		(uuid "46fe23f3-ab6c-5a18-ab63-1d37f1acdf73")
	)
	(text "no TVS, no bias resistors. It shares USART1 with J5: DI is PC4 (EXP_TX), RO reaches PC5 (EXP_RX) through 1k,"
		(exclude_from_sim no)
		(at 190.5 151.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a29b04a4-2653-58f9-87be-0942670c1ada")
	)
	(text "so a USB-UART adapter on J5 still wins. DE is PA5 (100k down), RE (active low) is PC10 (100k up):"
		(exclude_from_sim no)
		(at 190.5 154.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d120fbe5-1b9b-53da-b5f1-9d741de42197")
	)
	(text "both idle = shutdown, under 1 uA, and RO floats (firmware: pull PC5 up). Listening costs 1.8 mA."
		(exclude_from_sim no)
		(at 190.5 157.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "75a4e048-c637-5ba4-95a2-1e44b3969920")
	)
