	(text "Parked watch and evidence: accelerometer, secure element, panic button"
		(exclude_from_sim no)
		(at 20 129.8205 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b3c4a0a5-a357-5b4c-869a-6c1457f8b6dc")
	)
	(text "U15 LIS2DH12 on the STM32 I2C bus (0x19, SA0 high): wake-on-motion while parked (tow / break-in),"
		(exclude_from_sim no)
		(at 20 136.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0d614962-f0df-5392-9512-6832dc19678a")
	)
	(text "crash spikes while driving. INT1 -> PC14, INT2 -> PC15 (EXTI, wake from Stop)."
		(exclude_from_sim no)
		(at 20 139.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3e5d6fb0-0537-5ddd-8b05-66f71bd8d940")
	)
	(text "U16 ATECC608B (0x60) on the same bus: signs the frozen OBD speed window for traffic stop evidence."
		(exclude_from_sim no)
		(at 20 142.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8d1e2364-b028-57e7-87e5-745802bb4725")
	)
	(text "J9 panic button (hidden, on a cable): 1k series at the connector, then the ESD diode, 10k pull-up"
		(exclude_from_sim no)
		(at 20 145.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e743b7d-3dd0-5d05-8479-52da1906b153")
	)
	(text "and 100n at the pin, so a cable shorted to +12 V is limited to ~8 mA into the clamp."
		(exclude_from_sim no)
		(at 20 148.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "90aeca62-2f26-5875-b640-da81a6d1a346")
	)
	(text "PANIC_BTN = PC13 (WKUP2, wakes from Standby too). Closed = low."
		(exclude_from_sim no)
		(at 20 151.8205 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "588ff222-029e-5b95-a2cc-9ee64ef583bf")
	)
