	(text "STM32G474: vehicle-side MCU, QSPI flash, SWD, buttons, LED, CONFIG switch"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e6e0a14e-01ad-5d25-89f7-1fd50b3101b5")
	)
	(text "FDCAN1 is not used: its pins clash with USB (PA11/PA12) and BOOT0 (PB8)."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cb44728b-4f42-5cfc-b92a-b0ca3df045b7")
	)
	(text "HS-CAN (J1962 6/14) = FDCAN2 PB12/PB13. MS-CAN (3/11) = FDCAN3 PB3/PB4."
		(exclude_from_sim no)
		(at 20.32 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d5bd43de-8168-5923-bf89-724221346536")
	)
	(text "J1850 on TIM3: CH1 VPW RX, CH2 PWM RX (input capture), CH3/CH4 TX Bus+/Bus- (output compare)."
		(exclude_from_sim no)
		(at 20.32 28.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b58b615-9fd7-55e3-9f37-f5f593eea2ab")
	)
	(text "K-line on LPUART1 (PC0 RX / PC1 TX, TXINV: the NPN inverts); 5-baud init bit-bangs PC1. ESP32 on USART2 + RTS/CTS."
		(exclude_from_sim no)
		(at 20.32 31.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "40a763b0-6e14-5ca9-9c90-ae0914080b0c")
	)
	(text "PC3 switches DLC_SW (battery to the J1850 supply, comparators, K/L pull-ups); PB2 picks 7.24 V VPW / 4.79 V PWM."
		(exclude_from_sim no)
		(at 20.32 34.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ae1445dd-85fa-570a-8377-3965681ca72e")
	)
	(text "PB4/PB6 carry UCPD dead-battery pull-downs until firmware sets PWR_CR3.UCPD_DBDIS: both are safe low at reset."
		(exclude_from_sim no)
		(at 20.32 37.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da75d382-9b5c-58e7-baf2-12de65dfdd20")
	)
	(text "DLC_SW_EN is on PC3, not PC10: the system bootloader may drive USART3 TX (PC10) and would switch DLC_SW on."
		(exclude_from_sim no)
		(at 20.32 40.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5985a2da-68c9-5401-9da6-d6893096948c")
	)
	(text "Firmware turns on the internal pull-ups of PA15 (USER button) and PC0 (KLINE_RX, an open-collector output)."
		(exclude_from_sim no)
		(at 20.32 43.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6144150c-1ee4-5f4f-8d77-2f33e4b06892")
	)
	(text "VDDA / VREF+ are on 3V3 (100n + 1u at the pins): the ADC only reads the battery divider."
		(exclude_from_sim no)
		(at 20.32 46.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fc960367-d95b-52a6-a71f-152026d797c8")
	)
	(text "Decoupling: 100n at each VDD pin, 4.7u bulk, 100n + 1u at VDDA / VREF+"
