	(text "STM32G474: vehicle-side MCU, QSPI flash, SWD, buttons, LED, CONFIG switch"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e6e0a14e-01ad-5d25-89f7-1fd50b3101b5")
	)
	(text "FDCAN1 is not used: its pins clash with USB (PA11/PA12) and BOOT0 (PB8)."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cb44728b-4f42-5cfc-b92a-b0ca3df045b7")
	)
	(text "HS-CAN (J1962 6/14) = FDCAN2 PB12/PB13, nets CAN1_*. MS-CAN (3/11) = FDCAN3 PB3/PB4, nets CAN2_*."
		(exclude_from_sim no)
		(at 20.32 25.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c9c97e84-ce7b-5036-9582-c8d28c6a22e1")
	)
	(text "J1850 on TIM3: CH1 VPW RX, CH2 PWM RX (input capture), CH3/CH4 TX Bus+/Bus- (output compare)."
		(exclude_from_sim no)
		(at 20.32 28.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b58b615-9fd7-55e3-9f37-f5f593eea2ab")
	)
	(text "K-line on LPUART1 (PC0 RX / PC1 TX, TXINV: the NPN inverts); 5-baud init bit-bangs PC1. ESP32 on USART2 + RTS/CTS."
		(exclude_from_sim no)
		(at 20.32 31.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "40a763b0-6e14-5ca9-9c90-ae0914080b0c")
	)
	(text "PC3 switches DLC_SW (battery to the J1850 supply, comparators, K/L pull-ups); PB2 picks 7.24 V VPW / 4.79 V PWM."
		(exclude_from_sim no)
		(at 20.32 34.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ae1445dd-85fa-570a-8377-3965681ca72e")
	)
	(text "PB6 (ESP_PWR_EN) has the UCPD dead-battery pull-down until firmware sets PWR_CR3.UCPD_DBDIS: ESP32 off at reset."
		(exclude_from_sim no)
		(at 20.32 37.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69d5c651-2922-5cd1-a99d-6e82013a4a8a")
	)
	(text "PB4's (CAN2_TXD, where low is dominant) is kept off by R18, 10k from PA10 to GND (USB page)."
		(exclude_from_sim no)
		(at 20.32 40.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ffbfc496-aeec-516f-8e49-775c243c3bfb")
	)
	(text "DLC_SW_EN is on PC3; PC10 was avoided because the system bootloader may drive USART3 TX there."
		(exclude_from_sim no)
		(at 20.32 43.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b0cae89f-b29c-5233-9c2b-425f68789b30")
	)
	(text "Firmware turns on the internal pull-ups of PA15 (USER button) and PC0 (KLINE_RX, an open-collector output)."
		(exclude_from_sim no)
		(at 20.32 46.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9fbdb929-a5b3-5e47-8779-98d6871d19a4")
	)
	(text "VDDA / VREF+ are on 3V3 (100n + 1u at the pins): the ADC only reads the battery divider."
		(exclude_from_sim no)
		(at 20.32 49.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "278809d5-6493-53aa-bdd2-37320f331f04")
	)
	(text "Names: _M = the STM32 side of a 1k series resistor (ESP32 page); ESP_RTS / ESP_TX_MCU are named from the ESP32's side;"
		(exclude_from_sim no)
		(at 20.32 52.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5148a7a1-4a98-5272-b02c-22f070aea795")
	)
	(text "U2S = USB-to-serial (CH340C). EXP_PA5 / EXP_PC10 / EXP_PD2 also work the pod bus (RS-485 DE, /RE, POD_EN: USB page)."
		(exclude_from_sim no)
		(at 20.32 55.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d5af6cb6-0312-5271-8416-8e549e6baff7")
	)
	(text "Firmware must (full list: verify/REVIEW.md, \"Firmware obligations\")"
