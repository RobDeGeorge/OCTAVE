		)
		(uuid "96bd64cf-8624-58b3-bb45-cd7988f2a31d")
	)
	(text "Set PWR_CR3.UCPD_DBDIS first. Put PB4 / PB13 in AF (TXD high) before driving a CAN STB low."
		(exclude_from_sim no)
		(at 190.5 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f7bac896-cfb0-599f-a621-af87254f13aa")
	)
