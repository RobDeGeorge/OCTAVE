<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for the Linux AppImage. build-appimage.sh copies it to
     AppDir/usr/share/metainfo/; AppImageHub and software centres read the
     name, licence, description and screenshots from here. The id must match
     the .desktop file's basename (com.robdegeorge.octave.desktop). -->
<component type="desktop-application">
  <id>com.robdegeorge.octave</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>OCTAVE</name>
  <summary>Open-source cross-platform telematics for an augmented vehicle experience</summary>
  <developer id="com.robdegeorge">
    <name>Rob DeGeorge</name>
  </developer>

  <description>
    <p>
      OCTAVE is an infotainment system you run on your own hardware: a Raspberry Pi
      behind the dash, a laptop in a project car, or a tablet. It plays local music
      and Spotify, reads live data from the car over OBD-II, mirrors an Android phone
      over USB, and recolours its interface to match the album art.
    </p>
    <p>Features:</p>
    <ul>
      <li>Local music player and Spotify control, with themes that follow the album art</li>
      <li>Live OBD-II data through ELM327 adapters, with customisable gauge dashboards and a shift light</li>
      <li>Android phone mirroring over USB, with nothing to install on the phone</li>
      <li>3D vehicle view driven by an IMU, plus support for gesture sensors and a wireless volume knob</li>
      <li>Touch-first interface designed for wide dash displays</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.robdegeorge.octave.desktop</launchable>
  <provides>
    <binary>octave</binary>
  </provides>

  <url type="homepage">https://github.com/RobDeGeorge/OCTAVE</url>
  <url type="bugtracker">https://github.com/RobDeGeorge/OCTAVE/issues</url>
  <url type="vcs-browser">https://github.com/RobDeGeorge/OCTAVE</url>

